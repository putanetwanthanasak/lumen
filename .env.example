# Copy to .env and fill in. Never commit .env.

# Postgres (docker-compose)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Password of the app's own role lumen_app (S2), created on first container init.
LUMEN_APP_PASSWORD=

# App (04 section 12)
# The app and the tests connect as lumen_app, e.g.
#   postgresql+psycopg://lumen_app:<LUMEN_APP_PASSWORD>@127.0.0.1:5432/lumen
DATABASE_URL=
TEST_DATABASE_URL=
# Migrations (and test clean-up) only: the POSTGRES_USER superuser, same databases.
MIGRATION_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
# Serve /docs, /redoc and /openapi.json (S12). Off unless true.
DEBUG=false
WEBHOOK_SECRET_SHOPDEMO=
PROVIDER_MODE=mock
# Payoff assistant consolidation estimate (L70): EXAMPLE values, not a real rate.
# Yearly rate as a decimal string (0.18 = 18% a year) and the term in months.
CONSOLIDATION_EXAMPLE_ANNUAL_RATE=0.18
CONSOLIDATION_EXAMPLE_TERM_MONTHS=24
# The mock bank's answer to every consolidation request (L71): approve or decline.
CONSOLIDATION_MOCK_DECISION=approve
LLM_PROVIDER=
LLM_MODEL_PLANNER=
LLM_MODEL_CATEGORIZER=
LLM_API_KEY=
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASS=
